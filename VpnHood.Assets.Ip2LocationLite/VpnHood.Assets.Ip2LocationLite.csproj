<Project Sdk="Microsoft.NET.Sdk">

  <!-- Inert asset package: the .nupkg ships DATA and inspectable MSBuild XML, NO code. There is no
       source here, no assembly is emitted (IncludeBuildOutput=false) and there are no dependencies -
       so nothing in a consumer's codebase can take a reference on this package, which is the point:
       an asset package is a store of bytes, not a library.

       What it carries:
         buildTransitive/IpLocations.zip      the database: one stored entry per country ({code}.ips),
                                              plus _checksum.txt naming the build
         buildTransitive/<PackageId>.targets  places both where the consuming app's platform reads
                                              files, at any reference depth
         build/<PackageId>.targets            forwards to the above for a direct PackageReference

       Reading it is VpnHood.Core.Toolkit's AssetStore, the one class shared by every asset package
       of ours: AssetStore.OpenRead("iplocations/IpLocations.zip"). That path is the whole contract
       between the targets and that call - there is no code here to hold it.

       Version flows from pub/PubVersion.json through the workflow's csproj bump. -->
  <PropertyGroup>
    <Description>The IP2Location LITE database (IP ranges for every country) as an inert asset package: the zip plus MSBuild targets that place it beside the consuming app. No compiled code, so Android carries it once rather than once per CPU architecture.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>VpnHood.Assets.Ip2LocationLite</PackageId>
    <IsPackable>true</IsPackable>

    <!-- Emit no assembly into the package and nothing to symbolize; compile no stray files; and do
         not fabricate a dependencies group (there are none). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Content-only package: silence the "no lib/ assemblies" advisory, and the compiler's own
         complaint that a project with no source has no source. -->
    <NoWarn>$(NoWarn);NU5128;CS2008</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Company>OmegaHood LLC</Company>
    <Copyright>© OmegaHood LLC. All rights reserved.</Copyright>
    <PackageIcon>VpnHood.png</PackageIcon>
    <PackageProjectUrl>https://github.com/vpnhood/VpnHood.Assets.IpLocations</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vpnhood/VpnHood.Assets.IpLocations</RepositoryUrl>
    <Version>7.0.746</Version>
    <PackageTags>IP Geolocation, IP2Location, VPN, Country Detection</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The entire payload, as an explicit allowlist of exactly what ships. -->
  <ItemGroup>
    <None Include="Resources\IpLocations.zip" Pack="true" PackagePath="buildTransitive\IpLocations.zip" />
    <None Include="buildTransitive\VpnHood.Assets.Ip2LocationLite.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="build\VpnHood.Assets.Ip2LocationLite.targets" Pack="true" PackagePath="build\" />
    <None Include="..\VpnHood.png" Pack="true" PackagePath="" />
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
